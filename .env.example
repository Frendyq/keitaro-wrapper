# Copy this file to .env and fill in the values.
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=put-your-api-key-here

# SQLite by default. For PostgreSQL use postgresql+psycopg://user:password@localhost:5432/wrapper
DATABASE_URL=sqlite:///./wrapper.db

# Used by the campaign creator to look up ids in Keitaro.
# Leave DOMAIN_NAME empty to use the first active domain of the account.
DOMAIN_NAME=
GROUP_NAME=FORTESTS
SOURCE_NAME=FORTESTS

# Prefilled in the creation form.
NAME_PREFIX=test_musaev_
